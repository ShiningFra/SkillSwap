DATABASE_URL=postgres://postgres@localhost:5432/skillswap
ALLOWED_ORIGIN=http://localhost:3000
# En production : COOKIE_SECURE=true (par défaut) et un secret d'au moins 32 caractères.
SMS_PEPPER=
PORT=3001

# Lien envoyé par e-mail (par défaut : ALLOWED_ORIGIN) et envoi réel des e-mails (obligatoire en production).
APP_URL=http://localhost:3000
# SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.com:465
# MAIL_EXPEDITEUR=SkillSwap <no-reply@ton-domaine.cm>

# Notifications sur l'appareil (Web Push). Générer les clés une fois : npx web-push generate-vapid-keys
# Absentes, la fonction est simplement désactivée. Ne jamais publier la clé privée.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:ton-adresse@exemple.com

# Recherche par le sens (modèle multilingual-e5-small, ~120 Mo, téléchargé une fois au premier usage, puis gardé en cache).
# EMBEDDINGS_DISABLED=true la coupe ; EMBEDDINGS_DIR pointe vers une copie locale du modèle (déploiement sans internet).
# EMBEDDINGS_DISABLED=false
# Le modèle est détecté dans models/ à la racine du projet API (voir README).
